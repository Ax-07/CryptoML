# Exemple de variables d'environnement ; documentation uniquement.
# À répartir entre backend et frontend une fois les projets implémentés.
APP_ENV=development
APP_TIMEZONE=UTC
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

DATA_ROOT=./data
ARTIFACTS_ROOT=./artifacts
DATABASE_URL=postgresql+psycopg://cryptoml:CHANGE_ME@127.0.0.1:5432/cryptoml
MLFLOW_TRACKING_URI=./mlruns
BINANCE_FAPI_BASE_URL=https://fapi.binance.com

# Frontend Next.js : UNIQUEMENT URL publique, jamais de secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Aucune clé privée d'exchange n'est requise pour collecter les données publiques.
